output/
*.log

# RB folder (contains all archived, backup, and raw reference files ~24GB)
RB/
reference_repo/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Results placeholders (do not ignore .gitkeep)
!.gitkeep
